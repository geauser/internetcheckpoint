{
  "name": "internetcheckpoint",
  "version": "0.0.0",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/download": "^8.0.2",
    "@types/jsdom": "^21.1.1",
    "download": "^8.0.0",
    "jsdom": "^22.1.0",
    "sst": "^3.17.38",
    "tsx": "^3.12.7",
    "ttab": "^0.8.0",
    "typescript": "^5.0.4"
  },
  "private": true,
  "scripts": {
    "firebase": "cd firebase && mkdir -p persistent-export && firebase emulators:start --import ./persistent-export --export-on-exit ./persistent-export",
    "dev": "sst dev",
    "build": "sst build",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "console": "sst console",
    "typecheck": "tsc --noEmit",
    "secrets:load": "sst secret load ./local.secrets --stage local",
    "secrets:load:dev": "sst secret load ./dev.secrets --stage dev",
    "secrets:load:prod": "sst secret load ./prod.secrets --stage prod"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
